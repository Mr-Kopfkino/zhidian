<Window x:Class="Qiban.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="致电" Icon="Assets/qiban.ico" Style="{StaticResource {x:Type Window}}" Width="1140" Height="780" MinWidth="940" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" Style="{StaticResource WindowFrameStyle}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="{DynamicResource CaptionHeight}"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="WindowTitleBar" Style="{StaticResource WindowTitleBarStyle}">
            <TextBlock Text="致电" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CaptionTextBrush}" Margin="18,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                <Button x:Name="MinimizeWindowButton" Click="OnMinimizeWindow" Style="{StaticResource WindowCaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="最小化" AutomationProperties.Name="最小化">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;"/>
                </Button>
                <Button x:Name="MaximizeWindowButton" Click="OnMaximizeWindow" Style="{StaticResource WindowCaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="最大化" AutomationProperties.Name="最大化">
                    <TextBlock x:Name="MaximizeGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE922;"/>
                </Button>
                <Button x:Name="CloseWindowButton" Click="OnCloseWindow" Style="{StaticResource WindowCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭" AutomationProperties.Name="关闭">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;"/>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="226"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource NavBrush}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="94"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,20,0,0">
                    <Button x:Name="ChatNavButton" Tag="chat" Click="OnNavigate" Style="{StaticResource NavButton}" ToolTip="聊天" Background="{DynamicResource NavSelectedBrush}">
                        <StackPanel><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="聊天" Foreground="{DynamicResource NavTextBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="MemoryNavButton" Tag="memory" Click="OnNavigate" Style="{StaticResource NavButton}" ToolTip="长期记忆">
                        <StackPanel><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{DynamicResource NavTextBrush}" HorizontalAlignment="Center"/><TextBlock Text="记忆" Foreground="{DynamicResource NavTextBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
                <Button x:Name="SettingsNavButton" Grid.Row="1" Tag="settings" Click="OnNavigate" Style="{StaticResource NavButton}" ToolTip="设置" VerticalAlignment="Center">
                    <StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{DynamicResource NavTextBrush}" HorizontalAlignment="Center"/><TextBlock Text="设置" Foreground="{DynamicResource NavTextBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
                </Button>
            </Grid>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="22,0,17,0">
                    <TextBlock Text="会话" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
                <Border Grid.Row="1" Margin="21,3,21,15" Height="1" Background="{DynamicResource LineBrush}"/>
                <ListBox x:Name="FriendList" Grid.Row="2" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" SelectionChanged="OnFriendSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource FriendItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="{DynamicResource AvatarCornerRadius}" Background="{DynamicResource AvatarBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="✦" FontSize="22" Foreground="{DynamicResource AvatarTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Tagline}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Margin="19,15,19,22">
                    <Button Click="OnAddFriend" Padding="12,11"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="17" Foreground="{DynamicResource AccentBrush}" Margin="0,-2,6,0"/><TextBlock Text="添加角色" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="ChatPage" Grid.Row="0">
                <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="{DynamicResource AvatarBrush}" CornerRadius="{DynamicResource AvatarCornerRadius}" VerticalAlignment="Center" ClipToBounds="True">
                            <Grid><TextBlock x:Name="AvatarFallback" Text="琴" Foreground="{DynamicResource AvatarTextBrush}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="AvatarImage" Stretch="UniformToFill"/></Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                            <TextBlock x:Name="FriendName" Text="五河琴里" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="FriendTagline" Text="" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Click="OnClearChat" Style="{StaticResource QuietButton}" ToolTip="清空当前会话" Content="清空聊天" VerticalAlignment="Center" Padding="8,7"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Background="{DynamicResource ChatBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="ChatBackgroundLayer" IsHitTestVisible="False" ClipToBounds="True"/>
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,22,26,20" CanContentScroll="False">
                        <StackPanel x:Name="MessagesPanel"/>
                    </ScrollViewer>
                    <Border x:Name="PortraitPanel" Grid.Column="1" Width="200" Background="{DynamicResource PortraitBrush}" Visibility="Collapsed" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}">
                        <Image x:Name="PortraitImage" Stretch="Uniform" VerticalAlignment="Bottom" Margin="6,18,6,0"/>
                    </Border>
                </Grid>
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="25,13,25,18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="StatusText" Text="未配置模型" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="OnRetry" Style="{StaticResource QuietButton}" Content="重试" Padding="9,4" FontSize="11"/>
                                <Button x:Name="StopButton" Click="OnStop" Style="{StaticResource QuietButton}" Content="停止" Padding="9,4" FontSize="11" IsEnabled="False"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBox x:Name="InputBox" Grid.Row="1" MinHeight="65" MaxHeight="130" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnInputPreviewKeyDown" TextChanged="OnInputEdited" Background="{DynamicResource FieldBrush}" BorderThickness="0" Padding="6"
                                 FontSize="14" VerticalContentAlignment="Top" AutomationProperties.Name="输入聊天消息"/>
                        <Grid Grid.Row="2" Margin="0,7,0,0">
                            <TextBlock Text="Enter 发送 · Shift + Enter 换行" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="SendButton" Click="OnSend" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="20,9">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="发送" Foreground="White" Margin="0,0,9,0"/><TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" Foreground="White" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="MemoryPage" Grid.Row="0" Visibility="Collapsed" Margin="28,25,28,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="长期记忆" FontSize="24" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="AnalyzeMemoryButton" Click="OnAnalyzeMemory" Content="立即整理" Margin="0,0,8,0"/>
                        <Button Click="OnNewMemory" Content="＋ 新建记忆" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,12,0,18">
                    <TextBlock x:Name="MemoryLearningStatus" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    <Expander Header="对话摘要" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <TextBox x:Name="ConversationSummary" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto"/>
                            <Button x:Name="ClearSummaryButton" Click="OnClearSummary" Content="清除摘要" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12"><TextBlock Text="搜索记忆" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/><TextBox x:Name="MemorySearch" TextChanged="OnMemorySearch" ToolTip="按内容或类别搜索"/></StackPanel>
                        <ListBox x:Name="MemoryList" Grid.Row="1" SelectionChanged="OnMemorySelected" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource FriendItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock Text="{Binding StateLabel}" HorizontalAlignment="Right" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MemoryPendingBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="approved"><Setter Property="Foreground" Value="{DynamicResource MemoryApprovedBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="archived"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" MaxHeight="64" FontSize="12" LineHeight="20" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="19">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="记忆详情" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="内容" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MemoryContent" MinHeight="112" MaxHeight="200" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                <TextBlock Text="类别" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{DynamicResource {x:Type ComboBox}}" x:Name="MemoryCategory" SelectedIndex="0"><ComboBoxItem Content="偏好"/><ComboBoxItem Content="事实"/><ComboBoxItem Content="事件"/><ComboBoxItem Content="约定"/></ComboBox>
                                <CheckBox x:Name="MemoryPinned" Content="置顶" Margin="0,16,0,3"/>
                                <TextBlock Text="到期日期（可选，yyyy-MM-dd）" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MemoryExpiry"/>
                                <TextBlock Text="留空则长期有效" Style="{StaticResource HelpText}"/>
                                <TextBlock x:Name="MemoryDetails" Style="{StaticResource HelpText}" Text="" Margin="0,17,0,16"/>
                                <WrapPanel><Button Click="OnSaveMemory" Content="保存修改" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Click="OnApproveMemory" Content="确认记忆" Margin="0,0,0,8"/></WrapPanel>
                                <WrapPanel><Button Click="OnArchiveMemory" Content="归档" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Click="OnDeleteMemory" Content="删除" Style="{StaticResource DangerButton}"/></WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="SettingsPage" Grid.Row="0" Visibility="Collapsed" Margin="28,25,28,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,21"/>
                <TabControl Grid.Row="1">
                    <TabItem Header="角色">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,10">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="角色设定" FontSize="17" FontWeight="SemiBold"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="名称" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RoleName" MaxLength="40"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="简介" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RoleTagline" MaxLength="100"/></StackPanel>
                                        </Grid>
                                        <TextBlock Text="人物设定" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="RolePersona" MinHeight="150" MaxHeight="280" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                        <TextBlock Text="开场白" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="RoleGreeting" MinHeight="62" MaxHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel><TextBlock Text="头像与立绘" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="静态图片，最大 20 MB" Style="{StaticResource HelpText}"/>
                                        <WrapPanel Margin="0,15,0,0"><Button Click="OnPickAvatar" Content="选择头像" Margin="0,0,8,8"/><Button Click="OnRemoveAvatar" Content="移除头像" Style="{StaticResource QuietButton}" Margin="0,0,16,8"/><Button Click="OnPickPortrait" Content="选择立绘" Margin="0,0,8,8"/><Button Click="OnRemovePortrait" Content="移除立绘" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/></WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="聊天背景" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="当前角色 · 静态图片，最大 20 MB" Style="{StaticResource HelpText}"/>
                                        <Image x:Name="BackgroundPreview" Height="88" MaxWidth="220" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,12,0,0" Visibility="Collapsed"/>
                                        <WrapPanel Margin="0,15,0,0">
                                            <Button x:Name="ChooseBackgroundButton" Click="OnPickBackground" Content="选择背景" Margin="0,0,8,0"/>
                                            <Button x:Name="RemoveBackgroundButton" Click="OnRemoveBackground" Content="移除背景" Style="{StaticResource QuietButton}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <WrapPanel Margin="0,18,0,0"><Button Click="OnExportFriend" Content="导出角色" Margin="0,0,8,8"/><Button Click="OnImportFriend" Content="导入角色" Margin="0,0,8,8"/><Button Click="OnDeleteFriend" Content="删除角色" Style="{StaticResource DangerButton}" Margin="0,0,0,8"/></WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="对话模型">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,10">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel><TextBlock Text="模型接口" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="支持兼容 Chat Completions 的云端及本地服务" Style="{StaticResource HelpText}"/>
                                        <TextBlock Text="服务地址" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ModelEndpoint"/>
                                        <TextBlock Text="接口根地址，如 http://127.0.0.1:1234/v1" Style="{StaticResource HelpText}"/>
                                        <TextBlock Text="模型名称" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ModelName"/>
                                        <TextBlock Text="API 密钥" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="ModelKey"/>
                                        <TextBlock Text="留空保留；输入 - 清除。无鉴权服务无需设置。" Style="{StaticResource HelpText}"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="温度（0–2）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ModelTemperature"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="上下文消息条数" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ContextCount"/></StackPanel>
                                        </Grid>
                                        <Button Click="OnTestConnection" Content="测试连接" HorizontalAlignment="Left" Margin="0,19,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel><TextBlock Text="长期记忆" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="召回字符上限" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MemoryBudget"/>
                                        <CheckBox x:Name="SuggestMemory" Content="手动模式下提取“记住”指令" Margin="0,15,0,0"/>
                                        <CheckBox x:Name="AutoMemoryEnabled" Content="自动整理长期记忆"/>
                                        <CheckBox x:Name="AutoSummaryEnabled" Content="自动生成对话摘要"/>
                                        <TextBlock Text="使用当前对话模型；明确事实自动保存，不确定内容待确认。" Style="{StaticResource HelpText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="主动聊天">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,10">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="触发方式" FontSize="17" FontWeight="SemiBold"/>
                                        <CheckBox x:Name="InitiativeIdleEnabled" Content="待机时主动聊天" Margin="0,18,0,0"/>
                                        <CheckBox x:Name="InitiativeActivityEnabled" Content="根据电脑活动主动聊天" Margin="0,14,0,0"/>
                                        <TextBlock Text="仅将前台应用名称与类型发送给对话模型" Style="{StaticResource HelpText}"/>
                                        <TextBlock Text="连续未回复上限（1–10 条）" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="InitiativeMaxUnanswered"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="触发状态" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="InitiativeStatus" Style="{StaticResource HelpText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="角色声音">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,10">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel><TextBlock x:Name="VoiceCharacterName" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="仅对当前角色生效" Style="{StaticResource HelpText}"/>
                                        <CheckBox x:Name="JapaneseMode" Content="日语聊天模式" Margin="0,14,0,0"/>
                                        <TextBlock Text="聊天显示语言" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Style="{DynamicResource {x:Type ComboBox}}" x:Name="ChatDisplayLanguage" IsEditable="True" IsEnabled="{Binding IsChecked, ElementName=JapaneseMode}">
                                            <ComboBoxItem Content="简体中文"/><ComboBoxItem Content="繁體中文"/><ComboBoxItem Content="日本語"/><ComboBoxItem Content="English"/><ComboBoxItem Content="한국어"/>
                                        </ComboBox>
                                        <TextBlock Text="可输入其他语言；语音固定日语，声模须支持日语" Style="{StaticResource HelpText}"/>
                                        <WrapPanel Margin="0,8,0,0"><CheckBox x:Name="VoiceEnabled" Content="启用语音"/><CheckBox x:Name="VoiceAutoPlay" Content="回复后自动朗读"/></WrapPanel>
                                        <TextBlock Text="语音引擎" Style="{StaticResource FieldLabel}"/><ComboBox Style="{DynamicResource {x:Type ComboBox}}" x:Name="VoiceProvider" SelectedIndex="0" SelectionChanged="OnVoiceProviderChanged"><ComboBoxItem Content="GPT-SoVITS 内置"/><ComboBoxItem Content="GPT-SoVITS 外接"/><ComboBoxItem Content="OpenAI-compatible"/><ComboBoxItem Content="Custom JSON"/></ComboBox>
                                        <TextBlock x:Name="EmbeddedVoiceStatus" Style="{StaticResource HelpText}"/>
                                        <StackPanel x:Name="VoiceConnectionPanel">
                                            <TextBlock Text="合成接口完整地址" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VoiceEndpoint"/>
                                            <TextBlock Text="语音 API 密钥（可选）" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="VoiceKey"/>
                                            <TextBlock Text="留空保留；输入 - 清除" Style="{StaticResource HelpText}"/>
                                        </StackPanel>
                                        <Grid x:Name="VoiceStandardFields"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="模型" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VoiceModel"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="音色 / Voice" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VoiceName"/></StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="VoiceLanguageLabel" Text="参考音频语言" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VoiceLanguage"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="VoiceGptPanel" Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel><TextBlock Text="角色模型" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="参考音频路径" Style="{StaticResource FieldLabel}"/>
                                        <DockPanel><Button DockPanel.Dock="Right" Click="OnPickReference" Content="选择" Margin="8,0,0,0"/><TextBox x:Name="VoiceReference"/></DockPanel>
                                        <TextBlock Text="参考音频文本" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VoiceReferenceText"/>
                                        <TextBlock Text="GPT 权重（.ckpt）" Style="{StaticResource FieldLabel}"/>
                                        <DockPanel><Button DockPanel.Dock="Right" Click="OnPickGptWeights" Content="选择" Margin="8,0,0,0"/><TextBox x:Name="VoiceGptWeights"/></DockPanel>
                                        <TextBlock Text="SoVITS 权重（.pth）" Style="{StaticResource FieldLabel}"/>
                                        <DockPanel><Button DockPanel.Dock="Right" Click="OnPickSovitsWeights" Content="选择" Margin="8,0,0,0"/><TextBox x:Name="VoiceSovitsWeights"/></DockPanel>
                                        <Button Click="OnMountVoice" Content="加载模型" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="VoiceTemplatePanel" Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel><TextBlock Text="自定义 JSON 请求" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="文本：{{text}}；语言：{{language}}（日语模式必填）" Style="{StaticResource HelpText}"/>
                                        <TextBox x:Name="VoiceTemplate" Margin="0,13,0,0" MinHeight="95" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                                    </StackPanel>
                                </Border>
                                <Button Click="OnTestVoice" Content="试听" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="数据与缓存">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,10">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel><TextBlock Text="存储" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="数据保存在程序目录" Style="{StaticResource HelpText}"/>
                                        <TextBlock Text="当前数据目录" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="StoragePath" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="StorageStats" Text="" Margin="0,17,0,0" FontSize="13"/>
                                        <Button Click="OnOpenData" Content="打开数据目录" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel><TextBlock Text="缓存管理" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="自动清理缓存，保留聊天与记忆" Style="{StaticResource HelpText}"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="缓存上限（MB）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CacheLimit"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="保留时间（小时）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CacheHours"/></StackPanel>
                                        </Grid>
                                        <Button Click="OnCleanCache" Content="清理缓存" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="系统及外部模型服务的缓存由其自行管理" Style="{StaticResource HelpText}" Margin="2,18,2,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="外观">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,10">
                            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="界面风格" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                    <ComboBox Style="{DynamicResource {x:Type ComboBox}}" x:Name="InterfaceThemeBox" SelectionChanged="OnInterfaceThemeChanged" AutomationProperties.Name="界面风格" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220">
                                        <ComboBoxItem Content="标准" Tag="standard"/>
                                        <ComboBoxItem Content="Windows XP" Tag="xp"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}" Padding="0,14,0,0" Margin="0,12,0,0">
                    <Button x:Name="SaveSettingsButton" Click="OnSaveSettings" Content="保存设置" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="25,10"/>
                </Border>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource NoticeBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}" Padding="23,8">
                <TextBlock x:Name="NoticeText" Text="" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="45"/>
            </Border>
        </Grid>
    </Grid>
    </Grid>
    </Border>
</Window>
